# App configuration. Everything here is bundled into the app and readable by
# anyone who installs it, so never put real secrets in this file.

# Backend base URL.
EXPO_PUBLIC_API_URL=https://api.pksoftabh.com

# Sent as the `Origin` header on every API call (see src/api/client.ts). The
# backend only answers whitelisted origins (anything else gets 401);
# http://localhost tells it this is a dev client. Ask the backend team to
# whitelist a dedicated origin for the app before release.
EXPO_PUBLIC_API_ORIGIN=https://wahchatore.com

# true  = products come from the built-in demo catalogue: catalogue, cart,
#         wishlist and order placement never call the API
# false = everything uses the live API above
# Sign-in, sign-up, password reset and saved addresses always use the live API.
EXPO_PUBLIC_USE_DEMO_PRODUCTS=false

# Optional fallback Razorpay key id. The key returned by the server wins.
EXPO_PUBLIC_RAZORPAY_KEY_ID=

# Flat platform fee added at checkout, in rupees. Must match the backend.
EXPO_PUBLIC_PLATFORM_FEE=20
EXPO_PUBLIC_LOGS=true

# true  = send this phone's push token to the backend (PushToken/Register and
#         /Remove — see docs/push-notifications-backend-guide.pdf). Turn on once
#         the backend team has built those endpoints.
# false = the token is only logged and shown on Account → Notifications.
EXPO_PUBLIC_PUSH_TOKEN_SYNC=false
