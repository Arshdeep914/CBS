{
  "expo": {
    "name": "CBS Kitchenware",
    "slug": "cbs-kitchenware",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cbskitchenware",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.cbskitchenware.trade",
      "buildNumber": "1",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cbskitchenware.trade",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/logo.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#121110",
            "image": "./assets/images/logo.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b759dd5c-e39f-4587-b373-e13783aecca6"
      }
    },
    "owner": "arshdeepecomwork"
  }
}
